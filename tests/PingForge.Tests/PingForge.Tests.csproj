<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PingForge.Tests</AssemblyName>
    <RootNamespace>PingForge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PingForge.Core\PingForge.Core.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Data\PingForge.Data.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Probing\PingForge.Probing.csproj" />
    <ProjectReference Include="..\..\src\PingForge.SystemState\PingForge.SystemState.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Analysis\PingForge.Analysis.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Routing\PingForge.Routing.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Tweaks\PingForge.Tweaks.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Orchestration\PingForge.Orchestration.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Network\PingForge.Network.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Service\PingForge.Service.csproj" />
    <ProjectReference Include="..\..\src\PingForge.App.ViewModels\PingForge.App.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файлы, которые тесты проверяют текстом: манифест окна, проект окна (чтобы манифест был
         подключён) и место, где собираются права канала. Копируются в вывод теста, потому что
         сборка идёт с artifacts-path вне папки решения — искать их обходом каталогов вверх нельзя.
         Как None, а не как Compile: исходник чужого проекта не должен компилироваться здесь. -->
    <None Include="..\..\src\PingForge.App\app.manifest" Link="checked-app.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\PingForge.App.csproj" Link="checked-PingForge.App.csproj" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача F: тест-«сторож» сверяет, что слой анализа подключён к проекту интерфейса. -->
    <None Include="..\..\src\PingForge.App.ViewModels\PingForge.App.ViewModels.csproj" Link="checked-PingForge.App.ViewModels.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\AboutView.xaml" Link="checked-AboutView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача I: сторожи «кнопка обновлений — в разделе «О программе»» и «фоновой проверки нет». -->
    <None Include="..\..\src\PingForge.App\App.xaml.cs" Link="checked-App.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App.ViewModels\UpdateCheckViewModel.cs" Link="checked-UpdateCheckViewModel.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\OptimizeView.xaml" Link="checked-OptimizeView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\TweaksView.xaml" Link="checked-TweaksView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача D: «Игры» показывают регионы и порты из справочника — это проверяется по разметке. -->
    <None Include="..\..\src\PingForge.App\Views\GamesView.xaml" Link="checked-GamesView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\SettingsView.xaml" Link="checked-SettingsView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\App.xaml" Link="checked-App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\MainWindow.xaml" Link="checked-MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Масштаб интерфейса: тест сверяет, что кнопки 100/125/150 % действительно что-то масштабируют. -->
    <None Include="..\..\src\PingForge.App\MainWindow.xaml.cs" Link="checked-MainWindow.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- Мастер первого запуска: его разметка тоже ссылается на ресурсы темы (опечатка = падение окна). -->
    <None Include="..\..\src\PingForge.App\Views\OnboardingView.xaml" Link="checked-OnboardingView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\SplashWindow.xaml" Link="checked-SplashWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\JournalView.xaml" Link="checked-JournalView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\ui-walkthrough.ps1" Link="checked-ui-walkthrough.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.github\workflows\build.yml" Link="checked-build.yml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Настройки пользователя: сторож читает порт реестра и живую проверку как текст. -->
    <None Include="..\..\src\PingForge.Tweaks.Windows\WindowsRegistryPort.cs" Link="checked-WindowsRegistryPort.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\c7-live-checks.ps1" Link="checked-c7-live-checks.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Windows\PipeAclFactory.cs" Link="checked-PipeAclFactory.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Windows\PipeClientInspector.cs" Link="checked-PipeClientInspector.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Host\ServiceProgram.cs" Link="checked-ServiceProgram.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\StartupGuard.cs" Link="checked-StartupGuard.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\SelfCheck.cs" Link="checked-SelfCheck.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- Волна 48: сторож видит, откуда берётся строка о подписи, и что старого обещания про EV в коде нет. -->
    <None Include="..\..\src\PingForge.App.ViewModels\MainViewModel.cs" Link="checked-MainViewModel.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App.ViewModels\ForbiddenActionsList.cs" Link="checked-ForbiddenActionsList.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\КАНАЛЫ-СЛУЖБЫ.md" Link="checked-pipes-doc.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="checked-README.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Подпись, SmartScreen и Smart App Control: сторож сверяет тексты программы и документации
         с тем, что написано в Microsoft Learn (тип сертификата на предупреждение не влияет). -->
    <None Include="..\..\docs\УСТАНОВКА.md" Link="checked-install-doc.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\ИСТОЧНИКИ.md" Link="checked-sources-doc.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Блокировки: сторож сверяет, что документ говорит «обхода в программе нет», а не наоборот. -->
    <None Include="..\..\docs\БЛОКИРОВКИ.md" Link="checked-blocking-doc.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\АРХИТЕКТУРА.md" Link="checked-architecture.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\install-service.ps1" Link="checked-install-service.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\render_ui_preview.py" Link="checked-render-ui-preview.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\check_ui_preview.js" Link="checked-check-ui-preview.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Orchestration\Realtime\RealtimeOptimizer.cs" Link="checked-RealtimeOptimizer.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\uninstall-service.ps1" Link="checked-uninstall-service.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
