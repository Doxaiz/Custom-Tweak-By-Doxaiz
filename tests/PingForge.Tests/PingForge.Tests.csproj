<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PingForge.Tests</AssemblyName>
    <RootNamespace>PingForge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PingForge.Core\PingForge.Core.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Data\PingForge.Data.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Probing\PingForge.Probing.csproj" />
    <ProjectReference Include="..\..\src\PingForge.SystemState\PingForge.SystemState.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Analysis\PingForge.Analysis.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Routing\PingForge.Routing.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Tweaks\PingForge.Tweaks.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Orchestration\PingForge.Orchestration.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Network\PingForge.Network.csproj" />
    <ProjectReference Include="..\..\src\PingForge.Service\PingForge.Service.csproj" />
    <ProjectReference Include="..\..\src\PingForge.App.ViewModels\PingForge.App.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файлы, которые тесты проверяют текстом: манифест окна, проект окна (чтобы манифест был
         подключён) и место, где собираются права канала. Копируются в вывод теста, потому что
         сборка идёт с artifacts-path вне папки решения — искать их обходом каталогов вверх нельзя.
         Как None, а не как Compile: исходник чужого проекта не должен компилироваться здесь. -->
    <None Include="..\..\src\PingForge.App\app.manifest" Link="checked-app.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\PingForge.App.csproj" Link="checked-PingForge.App.csproj" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача F: тест-«сторож» сверяет, что слой анализа подключён к проекту интерфейса. -->
    <None Include="..\..\src\PingForge.App.ViewModels\PingForge.App.ViewModels.csproj" Link="checked-PingForge.App.ViewModels.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\AboutView.xaml" Link="checked-AboutView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача I: сторожи «кнопка обновлений — в разделе «О программе»» и «фоновой проверки нет». -->
    <None Include="..\..\src\PingForge.App\App.xaml.cs" Link="checked-App.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App.ViewModels\UpdateCheckViewModel.cs" Link="checked-UpdateCheckViewModel.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\OptimizeView.xaml" Link="checked-OptimizeView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\TweaksView.xaml" Link="checked-TweaksView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Задача D: «Игры» показывают регионы и порты из справочника — это проверяется по разметке. -->
    <None Include="..\..\src\PingForge.App\Views\GamesView.xaml" Link="checked-GamesView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\Views\SettingsView.xaml" Link="checked-SettingsView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Windows\PipeAclFactory.cs" Link="checked-PipeAclFactory.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Windows\PipeClientInspector.cs" Link="checked-PipeClientInspector.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.Service.Host\ServiceProgram.cs" Link="checked-ServiceProgram.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PingForge.App\StartupGuard.cs" Link="checked-StartupGuard.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\КАНАЛЫ-СЛУЖБЫ.md" Link="checked-pipes-doc.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\uninstall-service.ps1" Link="checked-uninstall-service.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
