<Window x:Class="PingForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PingForge.App.Views"
        Title="Custom Tweak By Doxaiz" Height="820" Width="1180"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Шапка: имя программы, состояние и кнопка поддержки автора. -->
    <Border Grid.Row="0" Background="#0C1220" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#0A1626" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0">
          <Image Source="{StaticResource LogoImage}" Width="19" Height="19" Stretch="Uniform"
                 VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Custom Tweak By Doxaiz" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
          <Border Background="#131C2C" BorderBrush="#1F4034" BorderThickness="1" CornerRadius="999" Padding="9,3" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{Binding RightsNoteRu}" FontSize="11.5" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Grid.Column="3" Text="{Binding GameLineRu}" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />

        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="12,6"
                Content="Поддержать автора ↗" Click="SupportClick" ToolTip="Откроет страницу поддержки автора" />
      </Grid>
    </Border>

    <!-- Основа: слева разделы, справа содержимое выбранного. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Программа запускается молча: ничего не меняется, пока вы не нажмёте кнопку." />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Settings.SettingsFilePath, StringFormat=Настройки: {0}}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <StackPanel>
            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavButton}" Content="Оптимизация" IsChecked="True" Checked="NavChanged" />
            <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Content="Игры" Checked="NavChanged" />
            <RadioButton x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="Твики" Checked="NavChanged" />
            <RadioButton x:Name="NavJournal" Style="{StaticResource NavButton}" Content="Журнал" Checked="NavChanged" />
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Настройки" Checked="NavChanged" />
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Content="О программе" Checked="NavChanged" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18">
        <Grid>
          <views:OptimizeView x:Name="PageOptimize" DataContext="{Binding MainScreen}" />
          <views:GamesView x:Name="PageGames" Visibility="Collapsed" DataContext="{Binding Games}" />
          <views:TweaksView x:Name="PageTweaks" Visibility="Collapsed" DataContext="{Binding Tweaks}" />
          <views:JournalView x:Name="PageJournal" Visibility="Collapsed" DataContext="{Binding Journal}" />
          <views:SettingsView x:Name="PageSettings" Visibility="Collapsed" DataContext="{Binding Settings}" />
          <views:AboutView x:Name="PageAbout" Visibility="Collapsed" DataContext="{Binding MainScreen}" />
        </Grid>
      </ScrollViewer>
    </Grid>

      <!-- Подвал: честная плашка про макет интерфейса. -->
      <Border Grid.Row="2" Background="#0C1220" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
        <TextBlock Style="{StaticResource Caption}"
                   Text="Программа запускается молча: ничего не меняется, пока вы не нажмёте кнопку. Окно, разделы, трей и связь со службой проверяются на живой Windows при каждой сборке." />
      </Border>
    </Grid>

    <!-- Мастер первого запуска — поверх всего окна: как в BoosterX, но без единого изменения без согласия. -->
    <views:OnboardingView x:Name="SetupOverlay" DataContext="{Binding Setup}" />
  </Grid>
</Window>
