<UserControl x:Class="PingForge.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PingForge.App.ViewModels;assembly=PingForge.App.ViewModels">
  <UserControl.Resources>
    <!-- Панель графика: линии с разрывами, оси и честная «не измерялось» вместо пустоты. -->
    <DataTemplate x:Key="ChartPanelTemplate" DataType="{x:Type vm:ChartPanelViewModel}">
      <StackPanel Margin="0,10,0,0">
        <TextBlock Text="{Binding TitleRu}" FontWeight="SemiBold" FontSize="12.5" />

        <!-- Пустая панель — тоже контент: честная причина, а не «просто ничего». -->
        <Border Style="{StaticResource SunkenPanel}" Margin="0,4,0,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Caption}" Text="{Binding EmptyRu}" />
        </Border>

        <!-- График живёт на «утопленной» панели — так же, как пустое состояние: без данных
             панель одна и та же, меняется только содержимое. -->
        <Border Style="{StaticResource SunkenPanel}" Padding="8,6" Margin="0,4,0,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
          <Viewbox Stretch="Uniform">
            <Canvas Width="560" Height="132" Background="Transparent">
            <!-- Линии: отрезки без разрывов, разрыв измерения — новый отрезок, а не ноль. -->
            <ItemsControl ItemsSource="{Binding Segments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Polyline Points="{Binding PointsText, Converter={StaticResource ChartPoints}}" StrokeThickness="1.6">
                    <Polyline.Style>
                      <Style TargetType="Polyline">
                        <Setter Property="Stroke" Value="{StaticResource Accent2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LineKind}" Value="0">
                            <Setter Property="Stroke" Value="{StaticResource Muted}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LineKind}" Value="1">
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LineKind}" Value="2">
                            <Setter Property="Stroke" Value="{StaticResource Warn}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LineKind}" Value="3">
                            <Setter Property="Stroke" Value="{StaticResource Violet}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding LineKind}" Value="4">
                            <Setter Property="Stroke" Value="{StaticResource Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Polyline.Style>
                  </Polyline>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Подписи осей: позиция и текст приходят из модели (пиксели канвы). -->
            <ItemsControl ItemsSource="{Binding YLabels}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" FontSize="9" Foreground="{StaticResource Muted}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding XLabels}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" FontSize="9" Foreground="{StaticResource Muted}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Canvas>
          </Viewbox>
        </Border>

        <!-- Легенда: строка на линию, из DescribeRu ряда — со значением и числом измеренных точек. -->
        <ItemsControl ItemsSource="{Binding LegendLines}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="Оптимизация соединения" />

    <Border Style="{StaticResource Card}">
      <StackPanel DataContext="{Binding GameSelection}">
        <TextBlock Style="{StaticResource H2}" Text="Найденные игры" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding StatusRu}" />
        <ItemsControl ItemsSource="{Binding Found}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,7,0,7">
                <StackPanel>
                  <TextBlock Text="{Binding GameTitleRu}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding EndpointText}" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Flow.Transport}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="Кандидаты не из списка известных игр показываются отдельно и не выбираются как цель, пока не добавите игру (Мои игры)." />
      </StackPanel>
    </Border>

    <!-- Ответ программы на нажатие. Живёт на экране, а не в модальном окне: модальное окно
         раньше вешало главное окно до «(Not Responding)», и разделы не открывались. -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
            Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <!-- Цвет заголовка — по тону ответа: отказ красный, предупреждение жёлтое, сообщение
             циановое. Одним цветом отказ и удача выглядели одинаково. -->
        <TextBlock Text="{Binding NoticeTitleRu}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="{StaticResource Accent2}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding NoticeIsProblem}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoticeIsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Абзац ограничен по длине строки: во всю ширину окна его тяжело читать. -->
        <TextBlock x:Name="NoticeText" Style="{StaticResource ReadableText}"
                   Text="{Binding NoticeRu}" Margin="0,7,0,0" />
        <Button Style="{StaticResource GhostButton}" Content="Понятно" Margin="0,13,0,0"
                HorizontalAlignment="Left" Command="{Binding DismissNoticeCommand}" />
      </StackPanel>
    </Border>

    <!-- Кнопка и состояние — в одной карточке; показатели — отдельной строкой ниже.
         Раньше показатели делили строку с кнопкой, и на четыре карточки оставалось по сто точек:
         подписи резались. Это видел снимок окна со сборочной Windows.
         В оформлении это главная карточка экрана: акцентная кромка и больше воздуха. -->
    <Border Style="{StaticResource HeroCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
          <Button Style="{StaticResource PrimaryButton}"
                  Content="{Binding ButtonTextRu}"
                  Command="{Binding OptimizeCommand}"
                  HorizontalAlignment="Stretch" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Одна кнопка: замер «до», поиск игры, выбор пути. Повторное нажатие возвращает всё как было." />

          <!-- Проверка сети (задача G): рядом с главной кнопкой, но второстепенная. Только чтение
               и замеры — применений здесь нет; рекомендации уходят обычным путём «Твиков». -->
          <Button x:Name="CheckNetworkButton" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                  Content="Проверить сеть" HorizontalAlignment="Stretch"
                  Command="{Binding NetworkCheck.CheckCommand}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Семь проверок одним нажатием: что не так с сетью и что с этим делать. Ничего не меняет." />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <!-- Главное число экрана — последний замер живого потока. Прочерк, а не ноль, пока
               замера нет: «0 мс» выдавало бы отсутствие данных за идеальную сеть. Подпись рядом
               называет, что это за число, а строка ниже договаривает остальное словами. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="HeroRttValue" Style="{StaticResource StatValue}"
                       FontSize="38" LineHeight="42" Foreground="{StaticResource Accent}"
                       Text="{Binding CurrentRttMs, StringFormat={}{0:0.#}, TargetNullValue=—}"
                       ToolTip="Последний замер живого потока игры. Прочерк — замера ещё не было." />
            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                       Margin="9,0,0,8" Text="мс · задержка сейчас" />
          </Grid>
          <TextBlock Style="{StaticResource CaptionStrong}" Margin="0,2,0,0" TextWrapping="Wrap"
                     Text="{Binding RttLineRu}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding StatusRu}" />
          <!-- Способ замера: строка появляется, только когда служба его назвала. Пустая строка —
               не «способ: неизвестно», а отсутствие строки: выдумывать способ нельзя. -->
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{Binding MethodLineRu}"
                     Visibility="{Binding MethodLineRu, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Результаты «Проверить сеть» (задача G): семь пунктов со статусами и измеренными числами.
         Bufferbloat в списке ждёт согласия кнопкой «Понятно»: канал нагружается только после неё. -->
    <Border Style="{StaticResource Card}" x:Name="NetworkCheckCard">
      <StackPanel DataContext="{Binding NetworkCheck}">
        <TextBlock Style="{StaticResource H2}" Text="Проверка сети" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="MTU, DNS, двойной NAT, bufferbloat, шум Wi-Fi, фоновые загрузки, права и служба. Проверка только читает и измеряет: что нашлось, насколько важно и что делать — ниже." />
        <TextBlock x:Name="NetworkCheckStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding StatusRu}" />

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkCheckItemViewModel}">
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,7,0,7">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TitleRu}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="10,0,0,0" Text="{Binding StatusRu}" />
                  </Grid>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding DetailRu}" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding ActionRu}" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding LinkRu}" />
                  <Button Style="{StaticResource GhostButton}" Content="Понятно" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Command="{Binding ConsentCommand}"
                          Visibility="{Binding NeedsConsent, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding SummaryRu}" />
        <ItemsControl ItemsSource="{Binding FindingsRu}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding RecommendationLineRu}" />
        <Button x:Name="ApplyRecommendedButton" Style="{StaticResource PrimaryButton}" Padding="16,9"
                Content="Применить рекомендованное" HorizontalAlignment="Left" Margin="0,10,0,0"
                Command="{Binding ApplyRecommendedCommand}"
                Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <!-- Блокировки и доступ: ОДИН замер по кнопке, без единого пакета до нажатия.
         Программа не обходит блокировки — у неё нет ни туннеля, ни релея, ни перехвата пакетов.
         Поэтому карточка не обещает «сайт откроется», а называет, что видно на пути, и что проверить
         дальше. Тот же текст проверяется сторожем: обещаний обхода в программе нет. -->
    <Border Style="{StaticResource Card}" x:Name="AccessCard">
      <StackPanel DataContext="{Binding Access}">
        <TextBlock Style="{StaticResource H2}" Text="Блокировки и доступ" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding HonestTextRu}" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="AccessHostBox" AutomationProperties.Name="Сайт для проверки доступа"
                   Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Имя сайта или адрес: www.youtube.com, https://discord.com — расширение снимается автоматически" />
          <Button Grid.Column="1" x:Name="AccessCheckButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                  Content="Проверить доступ" AutomationProperties.Name="Проверить доступ к сайту"
                  Command="{Binding CheckCommand}"
                  ToolTip="Один обычный запрос: DNS, TCP, TLS. Ничего не меняет и ничего не обходит" />
        </Grid>

        <TextBlock x:Name="AccessStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{Binding StatusRu}" />

        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
          <TextBlock x:Name="AccessResultTitle" Text="{Binding ResultTitleRu}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="AccessResultDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{Binding ResultDetailRu}" />
          <TextBlock x:Name="AccessNextStep" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{Binding NextStepRu}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Путь до сервера (задача H): трасса только до адреса найденного игрового сервера и только
         при живой сессии. Без игры — честный текст «сначала запустите игру» и ноль пакетов.
         Результат раскрывается под кнопкой: таблица хопов, итог и подсказка «где растёт задержка». -->
    <Border Style="{StaticResource Card}" x:Name="ServerPathCard">
      <StackPanel DataContext="{Binding ServerPath}">
        <TextBlock Style="{StaticResource H2}" Text="Путь до сервера" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ExplanationRu}" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="ServerPathButton" Style="{StaticResource GhostButton}" Content="Показать путь"
                  Command="{Binding TraceCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource GhostButton}" Content="Отмена" Command="{Binding CancelCommand}"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TextBlock x:Name="ServerPathStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Text="{Binding StatusRu}" />

        <!-- Таблица: адрес, средний и 95-й RTT, потери. Анонимный хоп — строка «не отвечает»,
             неизмеренное — прочерк. Подсветка — хоп с наибольшим приростом, а не «виновник». -->
        <Border Style="{StaticResource SunkenPanel}" Margin="0,10,0,0"
                Visibility="{Binding HasHops, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="Хоп" />
              <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Узел" />
              <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Средний" />
              <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="95-й" />
              <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="Потери" />
              <TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="Прирост" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Hops}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ServerPathHopRow}">
                  <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding HopNumberRu}" />
                    <TextBlock Grid.Column="1" Text="{Binding AddressRu}" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Text}" />
                          <Setter Property="TextWrapping" Value="Wrap" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBottleneck}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Accent2}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding AvgRttRu}" />
                    <TextBlock Grid.Column="3" Text="{Binding P95RttRu}" />
                    <TextBlock Grid.Column="4" Text="{Binding LossRu}" />
                    <TextBlock Grid.Column="5" Text="{Binding GrowthRu}" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Muted}" />
                          <Setter Property="TextWrapping" Value="Wrap" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBottleneck}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Accent2}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding SummaryRu}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" FontWeight="SemiBold"
                   Text="{Binding GrowthNoteRu}" />
      </StackPanel>
    </Border>

    <!-- График сети (задача F): вместо статичной сводки чисел. Данные — только из замеров
         живой оптимизации: график не запускает собственных зондов и не отправляет пакетов. -->
    <Border Style="{StaticResource Card}" x:Name="ChartCard">
      <StackPanel DataContext="{Binding Chart}">
        <TextBlock Style="{StaticResource H2}" Text="График сети" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding HonestCaptionRu}" />

        <!-- Переключатели окна и текст о замерах: раньше это была одна горизонтальная панель без
             предела ширины, и на окне 860 строка уезжала за правый край. Колонка «*» даёт тексту
             предел — он переносится, а переключатели остаются в строку. -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Окно:" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,10,0" />
            <RadioButton GroupName="ChartWindow" Content="1 минута" Margin="0,0,14,0" Foreground="{StaticResource Text}"
                         IsChecked="{Binding IsWindow1, Mode=TwoWay}" />
            <RadioButton GroupName="ChartWindow" Content="5 минут" Margin="0,0,14,0" Foreground="{StaticResource Text}"
                         IsChecked="{Binding IsWindow5, Mode=TwoWay}" />
            <RadioButton GroupName="ChartWindow" Content="15 минут" Margin="0,0,16,0" Foreground="{StaticResource Text}"
                         IsChecked="{Binding IsWindow15, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding LastSampleRu}" VerticalAlignment="Center" />
        </Grid>

        <!-- Пустое состояние — честная надпись, а не пустая коробка без объяснения. -->
        <Border Style="{StaticResource SunkenPanel}" Padding="12" Margin="0,10,0,0"
                Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding EmptyStateRu}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
          <ContentControl Content="{Binding RttPanel}" ContentTemplate="{StaticResource ChartPanelTemplate}" />
          <ContentControl Content="{Binding JitterPanel}" ContentTemplate="{StaticResource ChartPanelTemplate}" />
          <ContentControl Content="{Binding LossPanel}" ContentTemplate="{StaticResource ChartPanelTemplate}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding WindowSummaryRu}" />
        <ItemsControl ItemsSource="{Binding NotesRu}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource Title}" Text="Что сделала программа" FontSize="16" Margin="0,6,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Маршрут для игрового сервера" />
        <TextBlock Style="{StaticResource Caption}"
                   Text="Маршрут добавляется только для адреса игрового сервера и снимается сразу после остановки. Это не глобальный VPN: остальной трафик идёт как обычно." />

        <TextBlock Text="Приоритет пакетов игры (DSCP 46)" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource Caption}"
                   Text="Политика QoS помечает пакеты процесса игры как «сетевое управление»: роутеры и провайдеры обрабатывают такие пакеты в первую очередь." />

        <TextBlock Text="Твики под ваш случай" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource Caption}"
                   Text="Из 47 твиков применяются только те, что подходят вашей сети. Остальное не трогается, а что именно изменилось — видно в разделе «Журнал»." />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource GhostButton}" Content="Обновить состояние" Command="{Binding RefreshStatusCommand}" Margin="0,0,8,0" />
      <Button Style="{StaticResource GhostButton}" Content="Починить сеть" Command="{Binding RepairNetworkCommand}"
              ToolTip="Снимает только свои остатки после аварии: маршруты, политики QoS и незакрытые операции" />
    </StackPanel>
  </StackPanel>
</UserControl>
