<UserControl x:Class="PingForge.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">

  <!-- Мастер первого запуска поверх окна: три шага, как в BoosterX.
       Ничего не применяется само — последний шаг показывает, что именно будет изменено. -->
  <!-- Подложка почти непрозрачная: сквозь мастер не должен просвечивать текст страницы. -->
  <Grid Background="#F5080D18">
    <Border MaxWidth="760" Margin="24" VerticalAlignment="Center"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="14" Padding="26">
      <StackPanel>

        <!-- Шаг 1. Приветствие -->
        <StackPanel Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Title}" Text="Добро пожаловать" FontSize="24" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="Custom Tweak By Doxaiz — оптимизация соединения для игр. Сейчас три коротких вопроса: по ответам программа сама подберёт, что включить. Ничего не меняется, пока вы не согласитесь на последнем шаге." />

          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="Что будет дальше" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="1. Три вопроса о компьютере и жалобах.  2. Совет — какой набор твиков подходит.  3. Одно нажатие: прежние значения запоминаются, вернуть можно одной кнопкой." />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Начать" Command="{Binding StartCommand}"
                    MinWidth="180" Margin="0,0,10,0" />
            <Button Style="{StaticResource GhostButton}" Content="Позже" Command="{Binding LaterCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Шаг 2. Три вопроса -->
        <StackPanel Visibility="{Binding IsQuestionsStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Title}" Text="Три вопроса" FontSize="22" />

          <TextBlock Text="Для чего этот компьютер?" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="Только игры" Margin="0,0,18,0" GroupName="Purpose"
                         IsChecked="{Binding PurposeIsGames, Mode=TwoWay}" />
            <RadioButton Content="Игры, и работа" Margin="0,0,18,0" GroupName="Purpose"
                         IsChecked="{Binding PurposeIsGamesAndWork, Mode=TwoWay}" />
            <RadioButton Content="Только работа" GroupName="Purpose"
                         IsChecked="{Binding PurposeIsWork, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock Text="Насколько мощный компьютер?" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="Слабый или ноутбук" Margin="0,0,18,0" GroupName="Strength"
                         IsChecked="{Binding StrengthIsWeak, Mode=TwoWay}" />
            <RadioButton Content="Средний" Margin="0,0,18,0" GroupName="Strength"
                         IsChecked="{Binding StrengthIsMedium, Mode=TwoWay}" />
            <RadioButton Content="Мощный" GroupName="Strength"
                         IsChecked="{Binding StrengthIsStrong, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock Text="Что больше мешает в играх?" FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="Высокий пинг" Margin="0,0,18,0" GroupName="Problem"
                         IsChecked="{Binding ProblemIsPing, Mode=TwoWay}" />
            <RadioButton Content="Рывки и отклик" Margin="0,0,18,0" GroupName="Problem"
                         IsChecked="{Binding ProblemIsFps, Mode=TwoWay}" />
            <RadioButton Content="И то, и другое" GroupName="Problem"
                         IsChecked="{Binding ProblemIsBoth, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Accent2}" TextWrapping="Wrap"
                     Text="{Binding HintRu}" />

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Дальше" Command="{Binding NextCommand}"
                    MinWidth="180" Margin="0,0,10,0" />
            <Button Style="{StaticResource GhostButton}" Content="Назад" Command="{Binding BackCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Шаг 3. Совет -->
        <StackPanel Visibility="{Binding IsRecommendationStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Title}" Text="Что предлагаю" FontSize="22" />

          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{Binding Recommended.TitleRu}" FontWeight="Bold" FontSize="18"
                         Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="{Binding Recommended.WhyRu}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="Профиль потребления будет выставлен по мощности компьютера. Перед изменением настроек Windows программа покажет подтверждение и предложит точку восстановления." />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyButtonRu}"
                    Command="{Binding ApplyCommand}" MinWidth="220" Margin="0,0,10,0" />
            <Button Style="{StaticResource GhostButton}" Content="Назад" Command="{Binding BackCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource GhostButton}" Content="Позже" Command="{Binding LaterCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Что сказать человеку, если выбор не записался. Мастер остаётся на экране, но не держит
             окно: «Понятно» закрывает его, и работа продолжается. -->
        <Border Margin="0,18,0,0" Padding="12" CornerRadius="10"
                Background="{StaticResource Sunken}" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                Visibility="{Binding HasResultRu, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ResultRu}" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
            <Button Style="{StaticResource GhostButton}" Content="Понятно"
                    Command="{Binding DismissProblemCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
