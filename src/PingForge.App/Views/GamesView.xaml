<UserControl x:Class="PingForge.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="Игры" />

    <!-- Один клик по игре: запуск и сразу предложение оптимизации. Числа — из настоящего поиска по диску. -->
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="{Binding SummaryRu}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Программа ищет игры только в известных местах (библиотеки Steam и обычные папки) и никогда не запускает игру сама: только по нажатию «Открыть»." />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Content="Найти игры заново"
                  Command="{Binding FindGamesCommand}"
                  ToolTip="Переискать библиотеки Steam и обычные папки" />
          <Button Style="{StaticResource GhostButton}" Content="Добавить игру" Margin="0,8,0,0"
                  Command="{Binding AddGameCommand}"
                  ToolTip="Добавить .exe игры, которой нет в списке известных. Анти-чит у своей игры неизвестен." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Задача D: где серверы игр. Регионы и порты — из справочника маршрутов, а не из разметки;
         «пинга до региона» здесь нет: адресов дата-центров игры не публикуют. -->
    <Border Style="{StaticResource Card}" x:Name="GameRegionsCard">
      <StackPanel>
        <TextBlock Text="{Binding Regions.HeadingTextRu}" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding Regions.HonestNoteTextRu}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusRu}" TextWrapping="Wrap" />
    </Border>

    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding TitleRu}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding AntiCheatRu}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding NoteRu}" />
                <!-- Задача D: у карточки видно, где серверы этой игры и какие порты игра публикует.
                     У игры вне справочника — честное «неизвестно», а не чужие регионы. -->
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" Text="{Binding RegionsLineRu}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" Text="{Binding PortsLineRu}" />
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                           Text="{Binding PathRu}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding StatusRu}" />
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding OpenButtonRu}"
                        Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" />
                <Button Style="{StaticResource GhostButton}" Content="Указать .exe" Margin="0,8,0,0"
                        Command="{Binding ChoosePathCommand}" HorizontalAlignment="Stretch" />
                <Button Style="{StaticResource GhostButton}" Content="Переименовать" Margin="0,8,0,0"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                        Click="RenameCustomClick" HorizontalAlignment="Stretch" />
                <Button Style="{StaticResource GhostButton}" Content="Удалить свою игру" Margin="0,8,0,0"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                        Click="RemoveCustomClick" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
