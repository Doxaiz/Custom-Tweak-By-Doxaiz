<UserControl x:Class="PingForge.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Вкладки оформлены общим стилем в App.xaml (пилюли): локальный стиль здесь больше не нужен,
       он дублировал цвета и спорил с шаблоном. -->
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="Журнал и возврат" />
    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
               Text="Что программа меняла, что подтвердила система и что можно вернуть одной кнопкой. Вторая вкладка — история сессий «до → после»." />

    <TabControl x:Name="JournalTabs" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem Header="Изменения">
        <StackPanel Margin="0,8,0,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <!-- Кнопки и сводка в Grid: у горизонтальной панели ширина не ограничена, и сводка
                   уезжала за правый край окна 860. Колонка «*» даёт тексту предел. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="Обновить журнал" Command="{Binding RefreshCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Выгрузить в CSV" Command="{Binding ExportCsvCommand}" Margin="12,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding SummaryRu}" />
              </Grid>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding StatusRu}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Фильтры" FontWeight="SemiBold" />
              <WrapPanel Margin="0,8,0,0">
                <StackPanel Margin="0,0,16,8">
                  <TextBlock Style="{StaticResource Caption}" Text="Поиск" />
                  <TextBox AutomationProperties.Name="Поиск по журналу" Width="220" Margin="0,4,0,0"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                  <TextBlock Style="{StaticResource Caption}" Text="Тип" />
                  <ComboBox AutomationProperties.Name="Тип записи" Width="160" Margin="0,4,0,0"
                            SelectedIndex="{Binding KindFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="всё" />
                    <ComboBoxItem Content="твики" />
                    <ComboBoxItem Content="маршрут" />
                    <ComboBoxItem Content="QoS" />
                    <ComboBoxItem Content="живая оптимизация" />
                    <ComboBoxItem Content="откаты" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                  <TextBlock Style="{StaticResource Caption}" Text="Статус" />
                  <ComboBox AutomationProperties.Name="Статус записи" Width="160" Margin="0,4,0,0"
                            SelectedIndex="{Binding StatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="всё" />
                    <ComboBoxItem Content="успех" />
                    <ComboBoxItem Content="ошибка" />
                    <ComboBoxItem Content="нужна перезагрузка" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                  <TextBlock Style="{StaticResource Caption}" Text="Дата" />
                  <ComboBox AutomationProperties.Name="Период записей" Width="160" Margin="0,4,0,0"
                            SelectedIndex="{Binding DateFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="за всё время" />
                    <ComboBoxItem Content="сегодня" />
                    <ComboBoxItem Content="последние 7 дней" />
                    <ComboBoxItem Content="последние 30 дней" />
                  </ComboBox>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="Сбросить фильтры" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource Warn}" Text="{Binding FilterHintRu}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding PaginationLineRu}" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding DisplayedRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding LineRu}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding StatusRu}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Style="{StaticResource GhostButton}" Content="Показать ещё" Command="{Binding ShowMoreCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"
                  Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding PaginationLineRu}" />
        </StackPanel>
      </TabItem>

      <!-- Задача J: история сессий оптимизации. Пусто — честная надпись, а не пустая таблица;
           «до → после» показывается только измеренное, незавершённая сессия так и называется. -->
      <TabItem x:Name="SessionsTab" Header="Сессии">
        <StackPanel Margin="0,8,0,0" DataContext="{Binding Sessions}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SessionsRefreshButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="Обновить сессии"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button x:Name="SessionsClearButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Очистить историю"
                        Command="{Binding ClearCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding SummaryRu}" />
              </Grid>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding StatusRu}" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Row}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                  Padding="12" Margin="0,0,0,10"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyRuText}" />
          </Border>

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding TitleRu}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding ResultRu}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ActionsRu}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding RollbackRu}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding StatusLineRu}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Сравнение двух сессий: разные серверы, одну и ту же сессию и сессии без известного
               адреса сравнивать нельзя — это сказано прямо в ответе, а не подразумевается. -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Сравнение двух сессий" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ComparisonHintRu}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ComboBox AutomationProperties.Name="Первая сессия для сравнения" Width="340" Margin="0,0,8,0"
                          ItemsSource="{Binding Rows}" DisplayMemberPath="TitleRu"
                          SelectedItem="{Binding SelectedFirst, Mode=TwoWay}" />
                <ComboBox AutomationProperties.Name="Вторая сессия для сравнения" Width="340" Margin="0,0,8,0"
                          ItemsSource="{Binding Rows}" DisplayMemberPath="TitleRu"
                          SelectedItem="{Binding SelectedSecond, Mode=TwoWay}" />
                <Button x:Name="CompareSessionsButton" Style="{StaticResource GhostButton}" Content="Сравнить"
                        Command="{Binding CompareCommand}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding ComparisonCaptionRu}" />
              <ItemsControl ItemsSource="{Binding ComparisonRu}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- График по дням: средний RTT «до» только до выбранного сервера. -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Средний RTT по дням" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding DailyCaptionRu}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Сервер:" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                <ComboBox AutomationProperties.Name="Сервер для графика RTT по дням" Width="340"
                          ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Daily}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding DayRu}" />
                      <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="10" Width="{Binding BarWidthPx}" Background="{StaticResource Accent2}"
                                CornerRadius="3" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding ValueRu}" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
