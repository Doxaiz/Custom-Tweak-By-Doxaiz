<UserControl x:Class="PingForge.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="О программе" />
    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
               Text="Custom Tweak By Doxaiz — оптимизация соединения для игр: маршрут, приоритет пакетов и твики Windows. Всё обратимо и без вмешательства в игру." />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Что программа делает" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Меряет задержку и потери до игрового сервера, выбирает путь, помечает пакеты игры приоритетом, включает подходящие настройки Windows. Что именно изменилось — видно в журнале, вернуть можно одной кнопкой." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Чего программа не делает никогда" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="• не влезает в игру и не трогает её память — ни DLL, ни чтения процессов игры;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не выключает анти-чит и не мешает ему работать;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не отключает Защитник, брандмауэр, обновления и контроль учётных записей;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не отключает проверку подписи драйверов;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не подменяет MAC- и IP-адреса;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не меняет настройки роутера за вас;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не обещает «пинг 0» и не гарантирует снижение на N мс;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не собирает и не отправляет ваши данные: телеметрии нет;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не меняет систему без вашего подтверждения и снапшота;" />
        <TextBlock Style="{StaticResource Caption}" Text="• не применяет твики при запуске — только по кнопке." />
        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="К сети обращается только проверка обновлений по кнопке (api.github.com) и замеры сети по вашей команде; больше — никуда. Телеметрии нет." TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Как проверить, что файл не подменён: скачайте SHA256SUMS.txt из релиза и сверьте — в PowerShell: certutil -hashfile &lt;файл&gt; SHA256, затем сравните глазами с хешем в файле релиза." TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Установщик пока не подписан сертификатом EV, поэтому SmartScreen предупреждает; мы не просим отключать защиту и не учим, как обходить предупреждение." TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Размер базы виден в Настройках: путь к pingforge.db, размер, число снапшотов и записей — рядом кнопка «Почистить» (оставляет 10 последних и новее 30 дней, снапшоты с незакрытыми операциями не удаляются)." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Поддержать автора" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Программа бесплатная и без рекламы. Если она помогла — можно поддержать автора: https://dalink.to/doxaiz" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Служба и права" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding RightsNoteRu}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding VersionsNoteRu}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Изменения вносит отдельная служба Windows. Без прав администратора приложение продолжает работать, но только меряет и показывает." />
      </StackPanel>
    </Border>

    <!-- Пакет для поддержки (задача Q): собирается только по кнопке, до нажатия ни один файл не читается.
         Сначала показывает список того, что попадёт в архив, затем записывает ZIP по уже показанному плану. -->
    <Border Style="{StaticResource Card}" x:Name="SupportBlock">
      <StackPanel DataContext="{Binding Support}">
        <TextBlock Text="Пакет для поддержки" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Если программа упала или помощь нужна дистанционно: соберите один архив с отчётом о сессии, журналами и сведениями о системе. Сам он никуда не отправляется — отправлять вам. Внутри будут адреса игровых серверов и пути к файлам на этом компьютере." />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="SupportPrepareButton" Style="{StaticResource GhostButton}" Content="Показать, что попадёт в пакет"
                  Command="{Binding PrepareCommand}" Margin="0,0,12,0" />
          <Button x:Name="SupportBuildButton" Style="{StaticResource GhostButton}" Content="Собрать пакет"
                  Command="{Binding BuildCommand}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding StatusRu}" />

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SummaryRu}"
                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding WarningRu}"
                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0"
                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding NameRu}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding DescriptionRu}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeRu}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusRu}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding TruncatedNoteRu}"
                           Visibility="{Binding TruncatedNoteRu, Converter={StaticResource StringToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding PathRu}"
                   Visibility="{Binding HasBuiltPackage, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <!-- Обновления (задача I): проверка только по кнопке. Программа ничего не скачивает
         и не устанавливает сама — показывает номер новой версии, открывает страницу релиза
         обычным браузером и даёт SHA-256 для ручной сверки после ручного скачивания. -->
    <Border Style="{StaticResource Card}" x:Name="UpdateBlock">
      <StackPanel DataContext="{Binding Updates}">
        <TextBlock Text="Обновления" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding CurrentVersionLineRu}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Проверка — только по кнопке ниже: в фоне программа в интернет не ходит. Новая версия не скачивается автоматически: файл берётся вручную со страницы релиза на GitHub, а контрольная сумма для сверки показывается здесь." />

        <!-- Кнопка и статус в Grid, а не в горизонтальном StackPanel: у StackPanel ширина не ограничена,
             поэтому длинный статус растягивал строку шире страницы и обрезался справа. Колонка «*»
             даёт тексту предел, и он переносится. -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="CheckUpdatesButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="Проверить обновления"
                  Command="{Binding CheckUpdatesCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock x:Name="UpdateStatusText" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center"
                     Text="{Binding StatusRu}" />
        </Grid>

        <Button x:Name="OpenReleaseButton" Style="{StaticResource GhostButton}" Content="Открыть страницу релиза"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenReleaseClick"
                Visibility="{Binding HasReleasePage, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock x:Name="UpdateChecksumsText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   FontFamily="Consolas" Text="{Binding ChecksumsRu}"
                   Visibility="{Binding HasChecksums, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
