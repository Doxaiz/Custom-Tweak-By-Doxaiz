<UserControl x:Class="PingForge.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="Твики" />
    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
               Text="Каждый твик — одна настройка Windows. Ничего не применяется до нажатия кнопки, а перед применением программа запоминает прежние значения." />

    <!-- Пресеты: числа приходят из каталога, поэтому подпись не может разойтись с составом. -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource StatLabel}" Text="ПРЕСЕТ" Margin="0,0,0,9" />
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="Preset" Margin="0,0,8,8" Style="{StaticResource Chip}"
                           Content="{Binding ChipRu}"
                           ToolTip="{Binding PurposeRu}"
                           IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource Self}}"
                           Checked="PresetChanged" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedPresetNoteRu}" Margin="0,2,0,10" />

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Content="Показать состав" Margin="0,0,8,0"
                  ToolTip="Показать карточки пресета — без применения. Ползунки не двигаются."
                  Command="{Binding ShowPresetCommand}" />
          <Button Style="{StaticResource PrimaryButton}" Padding="16,9" Content="Применить пресет"
                  Command="{Binding ApplyPresetCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource GhostButton}" Content="Вернуть как было" Command="{Binding RollbackCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- DNS (задача D): не «ускоритель пинга», а выбор входа. Список резолверов приходит из
         GameRouteCatalog.FreeDnsRoutes — тот же, что меряет «Проверить сеть». Ничего не применяет. -->
    <Border Style="{StaticResource Card}" x:Name="DnsCard" DataContext="{Binding Dns}">
      <StackPanel>
        <TextBlock Text="{Binding TitleRu}" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding ExplanationRu}" />

        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" FontWeight="SemiBold"
                   TextWrapping="Wrap" Text="{Binding ListTitleRu}" />

        <ItemsControl ItemsSource="{Binding Resolvers}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                <StackPanel>
                  <TextBlock Text="{Binding ProviderRu}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding AddressesRu}" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Text="{Binding NoteRu}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{Binding MeasuredRu}" />
      </StackPanel>
    </Border>

    <!-- Задержка ввода (задача F): советник из PingForge.Analysis, подключённый к окну.
         Ничего не применяет: находки с приоритетом и связью с твиками каталога. -->
    <Border Style="{StaticResource Card}" x:Name="InputLatencyBlock" DataContext="{Binding InputLatency}">
      <StackPanel>
        <TextBlock Text="Задержка ввода" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Мышь, клавиатура, фоновая запись и очередь пакетов на сетевой карте — это задержка на вашей стороне, до сети. Проверка только читает: ничего не применяется." />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="Проверить задержку ввода" Command="{Binding CheckCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding StatusRu}" />
        </Grid>

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding SummaryRu}" />

        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource ChipBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,8,0">
                      <TextBlock Text="{Binding PriorityRu}" FontSize="11.5" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding TitleRu}" FontWeight="SemiBold" />
                  </Grid>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ExplanationRu}" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ActionRu}" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource Accent2}" Text="{Binding LinkRu}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding SkippedChecks}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="Показать связанные твики" Command="{Binding ShowRelatedTweaksCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding CountsRu}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Массовые действия -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="ВЫБОР" FontWeight="SemiBold" Margin="0,0,0,8" />
        <WrapPanel>
          <Button Style="{StaticResource GhostButton}" Content="Только рекомендуемое" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,8" />
          <Button Style="{StaticResource GhostButton}" Content="Включить все" Command="{Binding SelectAllCommand}" Margin="0,0,8,8" />
          <Button Style="{StaticResource GhostButton}" Content="Отключить все" Command="{Binding SelectNoneCommand}" Margin="0,0,8,8" />
          <Button Style="{StaticResource PrimaryButton}" Padding="16,9" Content="Применить отмеченное" Command="{Binding ApplySelectedCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectionLineRu}" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectionBreakdownRu}" Margin="0,2,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding SelectionBreakdownRu, Converter={StaticResource StringToVisibility}}" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusRu}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <!-- Что изменилось (задача K): было→стало по каждому твику с кнопкой «Вернуть только это». -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,10"
            Visibility="{Binding Changes.IsVisible, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Что изменилось" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding Changes.SummaryRu}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{StaticResource Muted}"
                   Text="{Binding Changes.SnapshotId, StringFormat=Снапшот: {0}}" />
        <ItemsControl ItemsSource="{Binding Changes.Rows}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding TitleRu}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{StaticResource Muted}"
                               Text="{Binding Code}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                      <Run Text="Было → стало: " Foreground="{StaticResource Muted}" />
                      <Run Text="{Binding ChangeLineRu}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{StaticResource Muted}"
                               Text="{Binding StatusRu}" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                          Content="Вернуть только это" Command="{Binding RevertCommand}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Фильтр по кодам (задача F): включается кнопками «Показать связанные твики» из проверок. -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,10"
            Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding FilterLineRu}" />
        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Показать весь каталог" Command="{Binding ClearFilterCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Порядок и поиск: в каталоге 47 карточек, и у человека два разных вопроса — «с чего начать»
         и «где тот твик из статьи». Порядок меняет только последовательность, поиск — видимую часть;
         отметки и пресеты при этом не трогаются. -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Style="{StaticResource StatLabel}" Text="ПОРЯДОК" Margin="0,0,0,9" />
        <ItemsControl ItemsSource="{Binding Orders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="TweakOrder" Margin="0,0,8,8" Style="{StaticResource Chip}"
                           Content="{Binding TitleRu}"
                           ToolTip="{Binding HintRu}"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                   Text="{Binding OrderLineRu}" />

        <TextBlock Style="{StaticResource StatLabel}" Text="ФИЛЬТРЫ" Margin="0,2,0,9" />
        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Style="{StaticResource ChipToggle}" Margin="0,0,8,8"
                        Content="{Binding TitleRu}"
                        ToolTip="{Binding HintRu}"
                        IsChecked="{Binding IsOn, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="{Binding FiltersLineRu}"
                   Visibility="{Binding FiltersLineRu, Converter={StaticResource StringToVisibility}}" />

        <TextBlock Style="{StaticResource StatLabel}" Text="ПОИСК" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
          <TextBox AutomationProperties.Name="Поиск по твикам" Width="300" VerticalContentAlignment="Center"
                   ToolTip="Название, описание, код или назначение твика"
                   Text="{Binding SearchRu, UpdateSourceTrigger=PropertyChanged}" />
          <Button Style="{StaticResource GhostButton}" Content="Очистить" Margin="8,0,0,0"
                  Command="{Binding ClearSearchCommand}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding SearchLineRu}" />
      </StackPanel>
    </Border>

    <!-- Список пуст только когда искать правда нечего: пустой экран без объяснения — ошибка. -->
    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
               Text="{Binding EmptyLineRu}"
               Visibility="{Binding HasVisibleRows, Converter={StaticResource InverseBoolToVisibility}}" />

    <!-- Карточки твиков: сетка по две в ряд, как в витрине. Фильтр показывает часть списка. -->
    <!-- Карточки твиков по группам: заголовок с числом карточек и числом отмеченных, внутри — сетка
         по две в ряд. Числа считаются по ползункам, поэтому заголовок не может разойтись со списком. -->
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <Grid Margin="0,2,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding TitleRu}" FontWeight="SemiBold" FontSize="14"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center"
                         Text="{Binding CountRu}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Width="420" Margin="0,0,10,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Переключатель без подписи: рядом стоит название твика, и это же название —
                   имя для экранного диктора. Состояние «включён/выключен» диктор читает сам. -->
              <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,3,12,0"
                        AutomationProperties.Name="{Binding TitleRu}"
                        IsChecked="{Binding IsOn, Mode=TwoWay}" />

              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding TitleRu}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding WhatItDoesRu}" />

                <WrapPanel Margin="0,8,0,0">
                  <Border Background="{StaticResource ChipBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,6,4">
                    <TextBlock Text="{Binding VerdictRu}" FontSize="11.5" />
                  </Border>
                  <Border Background="{StaticResource ChipBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,6,4">
                    <TextBlock Text="{Binding PresetsLineRu}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                  </Border>
                  <Border Background="{StaticResource ChipBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,6,4">
                    <TextBlock Text="{Binding FocusRu}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                  </Border>
                </WrapPanel>

                <!-- Подробности: свернуто по умолчанию, текст не вылезает за карточку. -->
                <Expander Header="Подробнее" Margin="0,4,0,0" Foreground="{StaticResource Muted}">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding VerdictWhyRu}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding Code, StringFormat=Код в журнале: {0}}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
