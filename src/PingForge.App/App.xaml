<Application x:Class="PingForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PingForge.App"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Тёмная тема: цвета те же, что в витрине (docs/custom-tweak-by-doxaiz.html), чтобы макет и программа выглядели одинаково. -->
      <Color x:Key="BgColor">#0B1120</Color>
      <Color x:Key="PanelColor">#111A2B</Color>
      <Color x:Key="LineColor">#1E2A42</Color>
      <Color x:Key="TextColor">#E6EDF7</Color>
      <Color x:Key="MutedColor">#8FA0BD</Color>
      <Color x:Key="AccentColor">#4ADE80</Color>
      <Color x:Key="Accent2Color">#38BDF8</Color>

      <!-- Показ/скрытие карточек по булеву полю модели: без своего кода, средствами WPF. -->
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <local:StringToVisibilityConverter x:Key="StringToVisibility" />
      <local:ChartPointsConverter x:Key="ChartPoints" />

      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />

      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
      </LinearGradientBrush>

      <!-- Логотип: неоновая монограмма D с мотивом сетевого маршрута (узлы и путь пинга),
           циан → электрический голубой → умеренный фиолетовый. Локальный векторный ресурс:
           ни внешних картинок, ни шрифтов, ни сети; DrawingImage масштабируется под HiDPI
           без мыла. Используется в шапке окна и на заставке — бренд-зона, интерфейс не тронут. -->
      <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
          <DrawingGroup>
            <GeometryDrawing>
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#22D3EE" Offset="0" />
                  <GradientStop Color="#38BDF8" Offset="0.55" />
                  <GradientStop Color="#A78BFA" Offset="1" />
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
              <GeometryDrawing.Geometry>
                <PathGeometry FillRule="EvenOdd"
                              Figures="M13,4 H27 C39,4 45,13 45,24 C45,35 39,44 27,44 H13 Z M21,13 V35 H26 C33,35 37,30 37,24 C37,18 33,13 26,13 Z" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing>
              <GeometryDrawing.Pen>
                <Pen Brush="#0B1120" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
              </GeometryDrawing.Pen>
              <GeometryDrawing.Geometry>
                <PathGeometry Figures="M7,35 L19,26 L29,30 L42,15" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#E0F2FE">
              <GeometryDrawing.Geometry>
                <EllipseGeometry Center="7,35" RadiusX="3" RadiusY="3" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#22D3EE">
              <GeometryDrawing.Geometry>
                <EllipseGeometry Center="19,26" RadiusX="3" RadiusY="3" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#A78BFA">
              <GeometryDrawing.Geometry>
                <EllipseGeometry Center="29,30" RadiusX="3" RadiusY="3" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#E0F2FE">
              <GeometryDrawing.Geometry>
                <EllipseGeometry Center="42,15" RadiusX="3.4" RadiusY="3.4" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingImage.Drawing>
      </DrawingImage>

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <!-- Внимание: именованный стиль ОТМЕНЯЕТ неявный, поэтому перенос строк надо
           задавать в каждом стиле отдельно. Без этого абзацы рисуются одной строкой
           и обрезаются по краю — именно так и было видно на снимке окна. -->
      <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>

      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="#04101F" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="#182338" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#16223A" />
                  <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#141F33" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Переключатель твика: то самое «красивое» вкл/выкл из требований. -->
      <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="44" Height="25">
                <Border x:Name="Track" Background="#1B2740" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" />
                <Ellipse x:Name="Knob" Width="17" Height="17" Fill="#8FA0BD" HorizontalAlignment="Left" Margin="4,0,0,0" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}" />
                  <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                  <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                  <Setter TargetName="Knob" Property="Fill" Value="#04101F" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
