<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PingForge.App.ViewModels</RootNamespace>
    <AssemblyName>PingForge.App.ViewModels</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Интерфейс не зависит от WPF: его модели представления проверяются тестами на любой машине.
         Слой Windows (окно, значки, канал) — отдельный проект поверх этого. -->
    <ProjectReference Include="..\PingForge.Core\PingForge.Core.csproj" />
    <ProjectReference Include="..\PingForge.Orchestration\PingForge.Orchestration.csproj" />
    <ProjectReference Include="..\PingForge.Service\PingForge.Service.csproj" />
    <!-- Каталог твиков читается напрямую: описание и вердикты — те же, что применяет служба. -->
    <ProjectReference Include="..\PingForge.Tweaks\PingForge.Tweaks.csproj" />
    <!-- Список известных игр — тот же, по которому движок ищет игровой процесс: один источник правды. -->
    <ProjectReference Include="..\PingForge.Network\PingForge.Network.csproj" />
    <!-- Слой анализа (задача F): график сети, советник задержки ввода и разбор конфликтов —
         готовый код PingForge.Analysis, подключённый к окну, а не переписанный заново. -->
    <ProjectReference Include="..\PingForge.Analysis\PingForge.Analysis.csproj" />
    <!-- Пробы (задача G): типы результатов замеров (bufferbloat), на которых строятся пункты
         проверки сети. Ссылка явная, а не транзитивная через Analysis: зависимость видна. -->
    <ProjectReference Include="..\PingForge.Probing\PingForge.Probing.csproj" />
  </ItemGroup>

</Project>
