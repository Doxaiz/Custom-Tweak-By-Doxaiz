<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Консольный исполняемый файл: диспетчер служб запускает его без окна, а руками видно журнал.
         WinForms не нужен вовсе — значит, службе достаточно базового рантайма .NET. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RootNamespace>PingForge.Service.Host</RootNamespace>
    <!-- Имя файла: служба не должна называться так же, как библиотека PingForge.Service. -->
    <AssemblyName>CustomTweakByDoxaiz.Service</AssemblyName>
    <Product>Custom Tweak By Doxaiz — служба</Product>
    <AssemblyTitle>Custom Tweak By Doxaiz — служба</AssemblyTitle>
    <StartupObject>PingForge.Service.Host.ServiceProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingForge.SystemState\PingForge.SystemState.csproj" />
    <ProjectReference Include="..\PingForge.Service\PingForge.Service.csproj" />
    <ProjectReference Include="..\PingForge.Service.Windows\PingForge.Service.Windows.csproj" />
    <ProjectReference Include="..\PingForge.Data\PingForge.Data.csproj" />
    <ProjectReference Include="..\PingForge.Orchestration\PingForge.Orchestration.csproj" />
    <ProjectReference Include="..\PingForge.Tweaks\PingForge.Tweaks.csproj" />
    <ProjectReference Include="..\PingForge.Tweaks.Windows\PingForge.Tweaks.Windows.csproj" />
  </ItemGroup>

</Project>
